#!/usr/bin/make -f

export CARGO_NET_OFFLINE=true

%:
	dh $@ --buildsystem=none

# Keep Cargo's vendored Cargo.toml.orig files; dh_clean would otherwise remove
# them before the offline build.
override_dh_clean:
	dh_clean -X.orig

override_dh_auto_configure:
	if [ ! -f .cargo/config.toml ] || [ ! -d vendor ]; then \
		echo "error: Debian builds require wayexpand-<version>-vendored.tar.gz" >&2; \
		echo "       the clean source archive cannot build without network access" >&2; \
		exit 1; \
	fi
	true

override_dh_auto_build:
	cargo build --release --locked -p wayexpand -p wayexpand-daemon -p wayexpand-ui -p wayexpand-gui -p wayexpand-backend-ibus

override_dh_auto_test:
	cargo test --locked --workspace

override_dh_install:
	dh_install --package=wayexpand target/release/wayexpand usr/bin/
	dh_install --package=wayexpand target/release/wayexpand-daemon usr/bin/
	dh_install --package=wayexpand target/release/wayexpand-gui usr/bin/
	dh_install --package=wayexpand target/release/wayexpand-ui usr/bin/
	dh_install --package=wayexpand target/release/wayexpand-ibus usr/bin/
	dh_install --package=wayexpand desktop/wayexpand-ibus.xml usr/share/ibus/component/
	dh_install --package=wayexpand desktop/wayexpand.desktop usr/share/applications/
	dh_install --package=wayexpand io.github.cyberducttape.WayExpand.metainfo.xml usr/share/metainfo/
	dh_install --package=wayexpand docs/wayexpand.1 usr/share/man/man1/
	dh_install --package=wayexpand assets/icon/hicolor/16x16/apps/wayexpand.png usr/share/icons/hicolor/16x16/apps/
	dh_install --package=wayexpand assets/icon/hicolor/24x24/apps/wayexpand.png usr/share/icons/hicolor/24x24/apps/
	dh_install --package=wayexpand assets/icon/hicolor/32x32/apps/wayexpand.png usr/share/icons/hicolor/32x32/apps/
	dh_install --package=wayexpand assets/icon/hicolor/48x48/apps/wayexpand.png usr/share/icons/hicolor/48x48/apps/
	dh_install --package=wayexpand assets/icon/hicolor/64x64/apps/wayexpand.png usr/share/icons/hicolor/64x64/apps/
	dh_install --package=wayexpand assets/icon/hicolor/128x128/apps/wayexpand.png usr/share/icons/hicolor/128x128/apps/
	dh_install --package=wayexpand assets/icon/hicolor/256x256/apps/wayexpand.png usr/share/icons/hicolor/256x256/apps/
	dh_install --package=wayexpand assets/icon/hicolor/512x512/apps/wayexpand.png usr/share/icons/hicolor/512x512/apps/
	dh_install --package=wayexpand systemd/wayexpand-input-method.service usr/lib/systemd/user/
	dh_install --package=wayexpand systemd/wayexpand-evdev.service usr/lib/systemd/user/
	# Bind packaged units to /usr/bin; never allow a stale ~/.local/bin binary
	# to win through a user-service PATH.
	for unit in wayexpand-input-method.service wayexpand-evdev.service; do \
		sed -i 's#%h/.local/bin/#/usr/bin/#g' debian/wayexpand/usr/lib/systemd/user/$$unit; \
	done
	# Keep evdev policies inert; the explicit helper activates one in /etc/udev/rules.d.
	dh_install --package=wayexpand udev/71-wayexpand-evdev.rules usr/share/wayexpand/udev/
	dh_install --package=wayexpand udev/69-wayexpand-evdev-uaccess.rules usr/share/wayexpand/udev/
	install -Dm755 scripts/install-evdev-permissions.sh \
		debian/wayexpand/usr/bin/wayexpand-install-evdev-access
	install -Dm644 expansions.toml \
		debian/wayexpand/etc/wayexpand/expansions.toml.example
