#!/usr/bin/make -f

export CARGO_NET_OFFLINE=true

%:
	dh $@ --buildsystem=cargo

# Vendored crates ship Cargo.toml.orig files that their .cargo-checksum.json
# lists; dh_clean deletes *.orig by default, which breaks the offline build.
override_dh_clean:
	dh_clean -X.orig

override_dh_auto_configure:
	cargo vendor vendor/ || true
	dh_auto_configure

override_dh_auto_build:
	dh_auto_build -- --release --locked

override_dh_auto_test:
	dh_auto_test -- --locked --workspace

override_dh_install:
	dh_install --package=wayexpand target/release/wayexpand usr/bin/
	dh_install --package=wayexpand target/release/wayexpand-daemon usr/bin/
	dh_install --package=wayexpand target/release/wayexpand-gui usr/bin/
	dh_install --package=wayexpand target/release/wayexpand-ui usr/bin/
	dh_install --package=wayexpand desktop/wayexpand.desktop usr/share/applications/
	dh_install --package=wayexpand io.github.itchyitchy123.WayExpand.metainfo.xml usr/share/metainfo/
	dh_install --package=wayexpand docs/wayexpand.1 usr/share/man/man1/
	dh_install --package=wayexpand assets/icon/hicolor/16x16/apps/wayexpand.png usr/share/icons/hicolor/16x16/apps/
	dh_install --package=wayexpand assets/icon/hicolor/24x24/apps/wayexpand.png usr/share/icons/hicolor/24x24/apps/
	dh_install --package=wayexpand assets/icon/hicolor/32x32/apps/wayexpand.png usr/share/icons/hicolor/32x32/apps/
	dh_install --package=wayexpand assets/icon/hicolor/48x48/apps/wayexpand.png usr/share/icons/hicolor/48x48/apps/
	dh_install --package=wayexpand assets/icon/hicolor/64x64/apps/wayexpand.png usr/share/icons/hicolor/64x64/apps/
	dh_install --package=wayexpand assets/icon/hicolor/128x128/apps/wayexpand.png usr/share/icons/hicolor/128x128/apps/
	dh_install --package=wayexpand assets/icon/hicolor/256x256/apps/wayexpand.png usr/share/icons/hicolor/256x256/apps/
	dh_install --package=wayexpand assets/icon/hicolor/512x512/apps/wayexpand.png usr/share/icons/hicolor/512x512/apps/
	dh_install --package=wayexpand systemd/wayexpand.service usr/lib/systemd/user/
	dh_install --package=wayexpand systemd/wayexpand-input-method.service usr/lib/systemd/user/
	dh_install --package=wayexpand systemd/wayexpand-evdev.service usr/lib/systemd/user/
	dh_install --package=wayexpand udev/71-wayexpand-evdev.rules usr/lib/udev/rules.d/
	dh_install --package=wayexpand expansions.toml etc/wayexpand/expansions.toml.example
