[Desktop Entry]
Type=Application
Name=WayExpand
Comment=Wayland-native text expansion settings
Exec=wayexpand-gui %f
Icon=wayexpand
Terminal=false
Categories=Utility;Accessibility;
Keywords=text;expansion;snippets;Wayland;picker;insert;
StartupNotify=true
Actions=picker;

[Desktop Action picker]
Name=Quick Insert Snippet
Name[de]=Snippet schnell einfügen
Exec=wayexpand-gui --picker
